@model Conta
@{ ViewData["Title"] = "Detalhes da conta"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>@Model.Nome</h1><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a></div>
<div class="card metric mb-4"><div class="card-body row"><div class="col-md-4"><small>Instituição</small><div>@Model.Instituicao</div></div><div class="col-md-4"><small>Tipo</small><div>@Model.Tipo</div></div><div class="col-md-4"><small>Saldo atual</small><div class="h4">@Model.Saldo.ToString("C")</div></div></div></div>
<div class="card mb-3"><div class="card-body">
<h2 class="h5">Transações</h2>
<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Descrição</th><th>Data</th><th class="text-end">Valor</th></tr></thead><tbody>
@foreach (var t in Model.Transacoes.OrderByDescending(t => t.Data)) { <tr><td>@t.Descricao</td><td>@t.Data.ToString("dd/MM/yyyy")</td><td class="text-end fw-bold @(t.Tipo == TipoTransacao.Receita ? "text-success" : "text-danger")">@((t.Tipo == TipoTransacao.Receita ? t.Valor : -t.Valor).ToString("C"))</td></tr> }
@if (!Model.Transacoes.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">Nenhuma transação nesta conta.</td></tr> }
</tbody></table></div>
</div></div>
<a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
