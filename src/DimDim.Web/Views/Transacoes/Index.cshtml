@model IEnumerable<Transacao>
@{ ViewData["Title"] = "Transações"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Transações</h1><a class="btn btn-primary" asp-action="Create">Nova transação</a></div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Descrição</th><th>Conta</th><th>Tipo</th><th>Data</th><th class="text-end">Valor</th><th></th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Descricao</a></td><td>@item.Conta?.Nome</td><td>@item.Tipo</td><td>@item.Data.ToString("dd/MM/yyyy")</td><td class="text-end fw-bold @(item.Tipo == TipoTransacao.Receita ? "text-success" : "text-danger")">@((item.Tipo == TipoTransacao.Receita ? item.Valor : -item.Valor).ToString("C"))</td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a> <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Excluir esta transação?')"><button class="btn btn-sm btn-outline-danger">Excluir</button></form></td></tr>
}
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma transação cadastrada.</td></tr> }
</tbody></table></div></div>
