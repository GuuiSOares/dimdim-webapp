<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    (() => {
        const parsePtBr = value => Number(String(value).replace(/\./g, "").replace(",", "."));

        $.validator.methods.number = function (value, element) {
            return this.optional(element) || Number.isFinite(parsePtBr(value));
        };

        $.validator.methods.range = function (value, element, parameters) {
            const number = parsePtBr(value);
            return this.optional(element) ||
                (number >= parsePtBr(parameters[0]) && number <= parsePtBr(parameters[1]));
        };
    })();
</script>
